types NUIRealmOverview
{
	type NUI_RL_diplomatic_relations_tab = widget {
		visible = "[And( GetGlobalVariable( 'NUI_RL_open_tab' ).IsSet, VariableSystem.HasValue( 'NUI_RL_tabs', 'tab_diplomatic_list' ) )]"
		size = { 100% 100% }
		allow_outside = yes

		using = Animation_Tab_Switch

		state = {
			name = _show
			on_start = "[GetScriptedGui( 'NUI_RL_open_diplomatic_list' ).Execute( GuiScope.SetRoot( Character.MakeScope ).End )]"
			on_start = "[GetScriptedGui( 'NUI_RL_set_meets_conditions' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'PLAYER', GetPlayer.MakeScope ).End )]"
		}
		state = {
			name = _hide
			on_start = "[GetScriptedGui( 'NUI_RL_close_diplomatic_list' ).Execute( GuiScope.SetRoot( Character.MakeScope ).End )]"
			on_start = "[GetVariableSystem.Clear( 'NUI_RL_filter_group_opinion' )]"
			on_start = "[GetVariableSystem.Clear( 'NUI_RL_filter_group_cb' )]"
			on_start = "[GetVariableSystem.Clear( 'NUI_RL_filter_group_faith' )]"
			on_start = "[GetVariableSystem.Clear( 'NUI_RL_vassal_list_show_dynasty' )]"
		}

		NUI_RL_character_list = {

			blockoverride "filter_reset" {
				datacontext = "[GetScriptedGui( 'NUI_RL_reset_diplomatic_list_filter' )]"
				onclick = "[GetVariableSystem.Clear( 'NUI_RL_filter_group_opinion' )]"
				onclick = "[GetVariableSystem.Clear( 'NUI_RL_filter_group_cb' )]"
				onclick = "[GetVariableSystem.Clear( 'NUI_RL_filter_group_faith' )]"
			}

			blockoverride "filter_buttons" {
				vbox = {
					# 称号階級 / Title Tier
					widget = {
						visible = "[GetScriptedGui( 'NUI_RL_show_filter_title_tiers' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
						size = { 160 40 }
						hbox = {
							name = "filter_title_tier"

							NUI_RL_filter_title_tier_button = {
								visible = "[GetScriptedGui( 'NUI_RL_show_filter_empire_tier' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
								datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_empire_tier' )]"
								blockoverride "tier_frame" {
									frame = 6
								}
								blockoverride "tooltip" {
									tooltip = "[empire|E]"
								}
							}
							NUI_RL_filter_title_tier_button = {
								visible = "[GetScriptedGui( 'NUI_RL_show_filter_kingdom_tier' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
								datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_kingdom_tier' )]"
								blockoverride "tier_frame" {
									frame = 5
								}
								blockoverride "tooltip" {
									tooltip = "[kingdom|E]"
								}
							}
							NUI_RL_filter_title_tier_button = {
								visible = "[GetScriptedGui( 'NUI_RL_show_filter_duchy_tier' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
								datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_duchy_tier' )]"
								blockoverride "tier_frame" {
									frame = 4
								}
								blockoverride "tooltip" {
									tooltip = "[duchy|E]"
								}
							}
							NUI_RL_filter_title_tier_button = {
								visible = "[GetScriptedGui( 'NUI_RL_show_filter_county_tier' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
								datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_county_tier' )]"
								blockoverride "tier_frame" {
									frame = 3
								}
								blockoverride "tooltip" {
									tooltip = "[county|E]"
								}
							}
						}
					}

					# 独立 / Independent
					NUI_RL_filter_checkbox = {
						visible = "[GetScriptedGui( 'NUI_RL_show_filter_is_independent' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
						datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_is_independent' )]"
						blockoverride "filter_label" {
							text = "NUI_RL_filter_is_independent_TEXT"
						}
					}

					# 隣接 / Neighboring
					NUI_RL_filter_checkbox = {
						visible = "[GetScriptedGui( 'NUI_RL_show_filter_is_neighboring' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
						datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_is_neighboring' )]"
						blockoverride "filter_label" {
							text = "NUI_RL_filter_is_neighboring_TEXT"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { -3 5 }
						divider_light = {
							layoutpolicy_horizontal = expanding
						}
					}
				}

				# 評価 / Opinion
				NUI_RL_filter_button_expand = {
					visible = "[ObjectsEqual( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter, GetPlayer )]"
					onclick = "[GetVariableSystem.Toggle( 'NUI_RL_filter_group_opinion' )]"
					text = "NUI_RL_filter_group_opinion_TEXT"
					blockoverride "checked" {
						checked = "[VariableSystem.Exists( 'NUI_RL_filter_group_opinion' )]"
					}
					blockoverride "filter_enabled" {
						visible = "[Or( GetGlobalVariable( 'NUI_RL_filter_high_opinion' ).IsSet, GetGlobalVariable( 'NUI_RL_filter_low_opinion' ).IsSet )]"
					}
				}
				vbox = {
					visible = "[VariableSystem.Exists( 'NUI_RL_filter_group_opinion' )]"
					using = Animation_ShowHide_Quick

					NUI_RL_filter_button = {
						datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_high_opinion' )]"
						text = "NUI_RL_filter_high_opinion_TEXT"
					}
					NUI_RL_filter_button = {
						datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_low_opinion' )]"
						text = "NUI_RL_filter_low_opinion_TEXT"
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { -3 5 }
						divider_light = {
							layoutpolicy_horizontal = expanding
						}
					}
				}

				# 大義名分 / Casus Belli
				NUI_RL_filter_button_expand = {
					visible = "[GetScriptedGui( 'NUI_RL_show_filter_group_cb' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Toggle( 'NUI_RL_filter_group_cb' )]"
					text = "NUI_RL_filter_group_cb_TEXT"
					blockoverride "checked" {
						checked = "[VariableSystem.Exists( 'NUI_RL_filter_group_cb' )]"
					}
					blockoverride "filter_enabled" {
						visible = "[Or( GetGlobalVariable( 'NUI_RL_filter_cb_they_has' ).IsSet, GetGlobalVariable( 'NUI_RL_filter_cb_against_them' ).IsSet )]"
					}
				}
				vbox = {
					visible = "[VariableSystem.Exists( 'NUI_RL_filter_group_cb' )]"
					using = Animation_ShowHide_Quick

					NUI_RL_filter_button = {
						datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_cb_they_has' )]"
						text = "NUI_RL_filter_cb_they_has_TEXT"
					}
					NUI_RL_filter_button = {
						datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_cb_against_them' )]"
						text = "NUI_RL_filter_cb_against_them_TEXT"
					}
				}

				# 信仰 / Faith
				NUI_RL_filter_button_expand = {
					visible = "[GetScriptedGui( 'NUI_RL_show_filter_group_faith' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Toggle( 'NUI_RL_filter_group_faith' )]"
					text = "NUI_RL_filter_group_faith_TEXT"
					blockoverride "checked" {
						checked = "[VariableSystem.Exists( 'NUI_RL_filter_group_faith' )]"
					}
					blockoverride "filter_enabled" {
						visible = "[Or( GetGlobalVariable( 'NUI_RL_filter_same_faith' ).IsSet, GetGlobalVariable( 'NUI_RL_filter_diff_faith' ).IsSet )]"
					}
				}
				vbox = {
					visible = "[VariableSystem.Exists( 'NUI_RL_filter_group_faith' )]"
					using = Animation_ShowHide_Quick

					NUI_RL_filter_button = {
						datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_same_faith' )]"
						text = "NUI_RL_filter_same_faith_TEXT"
					}
					NUI_RL_filter_button = {
						datacontext = "[GetScriptedGui( 'NUI_RL_toggle_filter_diff_faith' )]"
						text = "NUI_RL_filter_diff_faith_TEXT"
					}
				}

				# その他 / Other
				vbox = {
					widget = {
						size = { 160 0 }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { -3 5 }
						divider_light = {
							layoutpolicy_horizontal = expanding
						}
					}
					NUI_RL_filter_checkbox = {
						onclick = "[VariableSystem.Toggle( 'NUI_RL_vassal_list_show_dynasty' )]"
						datacontext = "[GetScriptedGui( 'NUI_reset_targeting_house_dynasty' )]"

						blockoverride "checked" {
							checked = "[VariableSystem.Exists( 'NUI_RL_vassal_list_show_dynasty' )]"
						}
						blockoverride "filter_label" {
							text = "NUI_RL_show_dynasty_TEXT"
						}
						blockoverride "tooltip" {}
					}
				}
			}

			blockoverride "list_header" {
				text_single = {
					text = "NUI_RL_num_of_rulers_TEXT"
					fontsize = 16
					default_format = "#bold;light_background"
					align = nobaseline
				}
			}

			blockoverride "target_character" {
				NUI_RL_diplomatic_list_button = {
					datacontext = "[GetGlobalVariable( 'NUI_RL_target' ).GetCharacter]"
					blockoverride "background" {
						using = Background_Area
					}
					blockoverride "not_targeting_forcus" {
						visible = no
					}
					blockoverride "is_target" {}
				}
			}

			blockoverride "list_contant" {
				vbox = {
					datamodel = "[Character.MakeScope.GetList( 'NUI_RL_character_list' )]"

					item = {
						NUI_RL_diplomatic_list_button = {
							visible = "[GetScriptedGui( 'NUI_RL_diplomatic_list_filter' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).AddScope( 'PLAYER', GetPlayer.MakeScope ).End )]"
						}
					}
				}
			}
		}
	}



	######################
	### タイプ / Types ###
	######################
	type NUI_RL_diplomatic_list_button = button_standard_hover {
		size = { 850 92 }
		datacontext = "[Scope.GetCharacter]"
		onclick = "[DefaultOnCharacterClick( Character.GetID )]"
		onrightclick = "[DefaultOnCharacterRightClick( Character.GetID )]"
		button_ignore = none

		state = {
			name = _mouse_enter
			on_start = "[Character.OnMouseEnter]"
		}
		state = {
			name = _mouse_leave
			on_start = "[Character.OnMouseLeave]"
		}

		block "background" {}

		# ツールチップ / Tooltip
		tooltip_visible = "[Not( IsInteractionMenuOpenForCharacter( Character.GetID ) )]"
		tooltipwidget = {
			cooltip_type = {
				blockoverride "interaction_info" {
					text = "CHARACTER_TOOLTIP_INSTRUCTION"
				}
			}
		}

		using = Animation_ShowHide_Quick

		hbox = {
			layoutpolicy_horizontal = expanding

			widget = {
				size = { 50 94 }

				icon = {
					visible = "[GetScriptedGui( 'NUI_RL_is_allied' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End )]"
					parentanchor = center
					size = { 40 40 }
					texture = "gfx/interface/icons/message_feed/alliance.dds"
					tooltip = "[alliance|E]"
				}
				icon = {
					visible = "[GetScriptedGui( 'NUI_RL_is_at_war' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End )]"
					parentanchor = center
					size = { 40 40 }
					texture = "gfx/interface/icons/casus_bellis/county_conquest_cb.dds"
					tooltip = "[war|E]"
				}
				icon = {
					visible = "[GetScriptedGui( 'NUI_RL_has_truce' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End )]"
					parentanchor = center
					size = { 40 40 }
					texture = "gfx/interface/icons/diplomatic_icons.dds"
					framesize = { 120 120 }
					frame = 3
					tooltip = "[truce|E]"
				}
			}

			portrait_head_small = {
				visible = "[Not( ObjectsEqual( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter, GetPlayer ) )]"
				blockoverride "opinion_box" {}
			}

			portrait_head_small = {
				visible = "[ObjectsEqual( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter, GetPlayer )]"
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				minimumsize = { 450 94 }
				maximumsize = { 450 94 }

				# キャラクター名 / Character Name
				text_single = {
					name = "character_name"
					layoutpolicy_horizontal = expanding
					raw_text = "[Character.GetNameNoTooltip], [Character.GetAge]"
					fontsize = 18
					fontsize_min = 13
					default_format = "#bold;light_background"
					align = nobaseline
					max_width = 430
				}

				text_single = {
					name = "diplomatic_relation_with_character"
					layoutpolicy_horizontal = expanding
					text = "[Character.Custom2( 'NuiRoListCharacterRelation', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter )]"
					default_format = "#italic;light_background"
					align = nobaseline
					max_width = 430
				}

				expand = {}

				# キャラクターの情報 / Character Info
				hbox = {
					name = "character_info"
					layoutpolicy_horizontal = expanding

					hbox = {
						name = "character_health"

						icon = {
							visible = "[Not( Character.IsDeadAndValid )]"
							size = { 26 26 }
							framesize = { 60 60 }
							frame = "[Character.GetHealthIconFrame]"
							texture = "gfx/interface/icons/character_status/icon_health.dds"
							tooltip = "[Character.GetHealthInfo]"
						}
						icon = {
							visible = "[Character.IsDeadAndValid]"
							size = { 26 26 }
							texture = "gfx/interface/icons/character_status/icon_dead.dds"
							tooltip = "CHARACTER_DEAD_TOOLTIP"
						}

						background = {
							using = Background_Area_Dark
							margin = { 5 5 }

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_circle.dds"
								blend_mode = alphamultiply
							}
						}
					}

					hbox = {
						name = "character_skills"
						background = {
							using = Background_Area_Dark
							margin = { 3 2 }
							alpha = 0.7
						}

						NUI_RL_character_skill = {
							tooltip = "[diplomacy|E]"
						}
						NUI_RL_character_skill = {
							blockoverride "skill_value" {
								text = "[Character.GetSkill( 'martial' )|V]"
							}
							blockoverride "skill_frame" {
								frame = 2
							}
							tooltip = "[martial|E]"
						}
						NUI_RL_character_skill = {
							blockoverride "skill_value" {
								text = "[Character.GetSkill( 'stewardship' )|V]"
							}
							blockoverride "skill_frame" {
								frame = 3
							}
							tooltip = "[stewardship|E]"
						}
						NUI_RL_character_skill = {
							blockoverride "skill_value" {
								text = "[Character.GetSkill( 'intrigue' )|V]"
							}
							blockoverride "skill_frame" {
								frame = 4
							}
							tooltip = "[intrigue|E]"
						}
						NUI_RL_character_skill = {
							blockoverride "skill_value" {
								text = "[Character.GetSkill( 'learning' )|V]"
							}
							blockoverride "skill_frame" {
								frame = 5
							}
							tooltip = "[learning|E]"
						}
					}

					hbox = {
						name = "skill_prowess"
						spacing = -6
						icon = {
							size = { 25 25 }
							texture = "gfx/interface/icons/icon_skills.dds"
							frame = 6
							framesize = { 60 60 }
						}
						NUI_RL_character_skill = {
							blockoverride "skill_value" {
								text = "[Character.GetProwess]"
								default_format = "#light_background"
							}
							blockoverride "skill_background" {}
						}
						tooltip = "[prowess|E]"
					}

					vbox = {
						layoutpolicy_vertical = expanding
						margin = { 0 8 }
						divider_light = {
							layoutpolicy_vertical = expanding
						}
					}

					NUI_RL_targeting_buttons = {}
				}
				expand = {}
			}

			vbox = {
				layoutpolicy_vertical = expanding
				margin = { 0 8 }
				divider_light = {
					layoutpolicy_vertical = expanding
				}
			}

			vbox = {
				minimumsize = { 100 0 }
				margin_left = 5
				spacing = 10

				text_single = {
					layoutpolicy_horizontal = expanding
					raw_text = "@soldier_icon! [Character.GetMilitaryStrengthText]"
					fontsize = 16
					default_format = "#bold;light_background"
					align = nobaseline
					using = Animation_ShowHide_Quick
					tooltip = "NUI_RL_military_strength_TT"

					using = tooltip_es
					using = Animation_ShowHide_Quick
				}
				text_single = {
					layoutpolicy_horizontal = expanding
					raw_text = "@gold_icon! [Character.GetGold|0]"
					fontsize = 16
					default_format = "#bold;light_background"
					align = nobaseline
					tooltip = "[gold|E]"

					using = tooltip_es
					using = Animation_ShowHide_Quick
				}
			}

			block "is_target" {
				hbox = {
					visible = "[Not( GetScriptedGui( 'NUI_RL_is_at_war' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End ) )]"

					# 大義名分 / Casus Belli
					widget = {
						visible = "[Or( GetScriptedGui( 'NUI_RL_has_cb' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End ), GetScriptedGui( 'NUI_RL_has_cb' ).IsShown( GuiScope.SetRoot( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).AddScope( 'TARGET', Character.MakeScope ).End ) )]"
						size = { 48 64 }
						icon = {
							parentanchor = bottom|hcenter
							texture = "gfx/interface/icons/character_interactions/declare_war_interaction.dds"
							size = { 42 42 }
						}
						flowcontainer = {
							parentanchor = top|hcenter
							ignoreinvisible = yes
							spacing = -5
							icon = {
								visible = "[GetScriptedGui( 'NUI_RL_has_cb' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End )]"
								texture = "gfx/interface/icons/symbols/icon_arrow_red_up.dds"
								size = { 25 25 }
							}
							icon = {
								visible = "[GetScriptedGui( 'NUI_RL_has_cb' ).IsShown( GuiScope.SetRoot( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).AddScope( 'TARGET', Character.MakeScope ).End )]"
								texture = "gfx/interface/icons/symbols/icon_arrow_green_down.dds"
								size = { 25 25 }
							}
						}
						tooltip = "[Character.Custom2( 'NuiRoCasusBelliToolTip', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter )]"
					}

					# 請求権 / Claim
					widget = {
						visible = "[Or( GetScriptedGui( 'NUI_RL_has_claim' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End ), GetScriptedGui( 'NUI_RL_has_claim' ).IsShown( GuiScope.SetRoot( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).AddScope( 'TARGET', Character.MakeScope ).End ) )]"
						size = { 48 64 }
						icon = {
							parentanchor = bottom|hcenter
							texture = "gfx/interface/icons/casus_bellis/claim_cb.dds"
							size = { 42 42 }
						}
						flowcontainer = {
							parentanchor = top|hcenter
							ignoreinvisible = yes
							spacing = -5
							icon = {
								visible = "[GetScriptedGui( 'NUI_RL_has_claim' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End )]"
								texture = "gfx/interface/icons/symbols/icon_arrow_red_up.dds"
								size = { 25 25 }
							}
							icon = {
								visible = "[GetScriptedGui( 'NUI_RL_has_claim' ).IsShown( GuiScope.SetRoot( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).AddScope( 'TARGET', Character.MakeScope ).End )]"
								texture = "gfx/interface/icons/symbols/icon_arrow_green_down.dds"
								size = { 25 25 }
							}
						}
						tooltip = "[Character.Custom2( 'NuiRoClaimToolTip', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter )]"
					}

					# 慣習的領土請求権 / De Jure
					widget = {
						visible = "[Or( GetScriptedGui( 'NUI_RL_has_de_jure_claim' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End ), GetScriptedGui( 'NUI_RL_has_de_jure_claim' ).IsShown( GuiScope.SetRoot( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).AddScope( 'TARGET', Character.MakeScope ).End ) )]"
						size = { 48 64 }
						icon = {
							parentanchor = bottom|hcenter
							texture = "gfx/interface/icons/casus_bellis/de_jure_cb.dds"
							size = { 42 42 }
						}
						flowcontainer = {
							parentanchor = top|hcenter
							ignoreinvisible = yes
							spacing = -5
							icon = {
								visible = "[GetScriptedGui( 'NUI_RL_has_de_jure_claim' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End )]"
								texture = "gfx/interface/icons/symbols/icon_arrow_red_up.dds"
								size = { 25 25 }
							}
							icon = {
								visible = "[GetScriptedGui( 'NUI_RL_has_de_jure_claim' ).IsShown( GuiScope.SetRoot( GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).AddScope( 'TARGET', Character.MakeScope ).End )]"
								texture = "gfx/interface/icons/symbols/icon_arrow_green_down.dds"
								size = { 25 25 }
							}
						}
						tooltip = "[Character.Custom2( 'NuiRoDeJureClaimToolTip', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter )]"
					}
				}

				hbox = {
					visible = "[GetScriptedGui( 'NUI_RL_is_at_war' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'TARGET', GetGlobalVariable( 'NUI_RL_target' ).GetCharacter.MakeScope ).End )]"
					layoutpolicy_horizontal = expanding

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "NUI_RL_at_war_with_them"
						fontsize = 16
						default_format = "#italic;light_background"
						align = nobaseline
					}
				}

			}
			expand = {}
		}

		widget = {
			name = "under_line"
			parentanchor = bottom|left
			size = { 850 4 }

			background = {
				using = Background_Area_Dark

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
					blend_mode = alphamultiply
				}
			}
		}
	}

	type NUI_RL_character_skill = hbox {
		minimumsize = { 25 0 }

		text_single = {
			block "skill_value" {
				text = "[Character.GetSkill( 'diplomacy' )|V]"
			}
			fontsize = 16
			align = nobaseline
		}
		block "skill_background" {
			background = {
				texture = "gfx/interface/window_character/character_view_skills_bg.dds"
				margin = { 2 3 }
				block "skill_frame" {
					frame = 1
				}
				framesize = { 70 26 }
			}
		}
	}
}