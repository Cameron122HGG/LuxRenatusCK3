types window_character {
	# 血脉按钮
	type Historical_Bloodline_Button = button_normal { #BLOODLINE
		name = "open_bloodline_list"
		#visible = "[GreaterThan_CFixedPoint( GuiScope.SetRoot( Character.MakeScope ).ScriptValue('trait_counter'), '(CFixedPoint)0.0' )]"

		block "size" {
			size = { 35 35 }
		}

		tooltip = "OPEN_BLOODLINE_LIST_TOOLTIP"
		using = tooltip_es

		state = {
			name = close_kill_list
			on_start = "[ToggleGameViewData( 'kill_list', Character.GetID  )]"
		}

		icon = {
			texture = "gfx/interface/buttons/button_lifestyles_base.dds"
			size = { 100% 100% }
		}

		button_icon = {
			texture = "gfx/interface/icons/flat_icons/bloodline.dds"
			onclick = "[VariableSystem.Toggle( 'bloodline_open' )]"
			onclick = "[PdxGuiTriggerAllAnimations( Select_CString( IsGameViewOpen('kill_list'), 'close_kill_list', '' ) )]"
			block "button_icon_size" {
				size = { 25 25 }
			}
			parentanchor = center

			modify_texture = {
				texture = "gfx/interface/icons/focuses/hud_icon_mask.dds"
				blend_mode = alphamultiply
			}
		}
	}
}
